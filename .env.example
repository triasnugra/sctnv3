# Salin menjadi .env untuk pemakaian lokal. TIDAK perlu API key (hanya data publik).
LOG_LEVEL=INFO
# Override daftar simbol (pisah koma). Kosong = pakai config/symbols.yaml
ENGINE_SYMBOLS=
# Override urutan provider data. Contoh: binance_rest,ccxt:okx,ccxt:kucoin
ENGINE_PROVIDERS=

# Opsional: hanya untuk scanner sumber coinmarketcap_rank (key gratis: pro.coinmarketcap.com)
CMC_API_KEY=
